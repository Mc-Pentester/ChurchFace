generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                      @id @default(cuid())
  email                      String                      @unique
  password                   String
  createdAt                  DateTime                    @default(now())
  image                      String?
  name                       String?
  bio                        String?
  role                       String                      @default("USER")
  city                       String?
  isBanned                   Boolean                     @default(false)
  isSuspended                Boolean                     @default(false)
  suspendedAt                DateTime?
  churchId                   String?
  permissions                Json?                       @default("{}")
  // Profile extensions
  coverImage                 String?
  firstName                  String?
  lastName                   String?
  country                    String?
  language                   String?                     @default("fr")
  ministry                   String?
  username                   String?                     @unique
  accounts                   Account[]
  adminLogs                  AdminLog[]
  audioTracks                AudioTrack[]
  chatMemberships            ChatMember[]
  churchAdmins               ChurchAdmin[]
  churchCourseEnrollments    ChurchCourseEnrollment[]
  churchEventAttendees       ChurchEventAttendee[]
  churchFollows              ChurchFollow[]
  churchMemberships          ChurchMember[]
  churchPostComments         ChurchPostComment[]
  churchPostLikes            ChurchPostLike[]
  comments                   Comment[]
  friendships2               Friendship[]                @relation("FriendshipReceiver")
  friendships1               Friendship[]                @relation("FriendshipSender")
  likes                      Like[]
  sentMessages               Message[]                   @relation("MessageSender")
  messageSeen                MessageSeen[]
  notificationsSent          Notification[]              @relation("NotificationSender")
  notificationsReceived      Notification[]              @relation("NotificationReceiver")
  posts                      Post[]
  prayerChainLinks           PrayerChainLink[]
  prayerLiveParticipants     PrayerLiveParticipant[]
  PrayerLiveRoom             PrayerLiveRoom[]
  prayerLiveRoomMembers      PrayerLiveRoomMember[]
  prayerLiveRoomParticipants PrayerLiveRoomParticipant[]
  prayerReactions            PrayerReaction[]
  prayerRequests             PrayerRequest[]
  prayerResponses            PrayerResponse[]
  prayerTestimonies          PrayerTestimony[]
  prayerVerses               PrayerVerse[]
  // NOUVELLES RELATIONS pour l'évolution du module Prières
  prayerChains               PrayerChain[]               @relation("PrayerChainOwner")
  prayerParticipants         PrayerParticipant[]
  prayerSchedules            PrayerSchedule[]
  prayerRooms                PrayerRoom[]                @relation("PrayerRoomModerator")
  prayerRoomParticipants     PrayerRoomParticipant[]
  prayerCampaigns            PrayerCampaign[]            @relation("PrayerCampaignCreator")
  prayerEngagements          PrayerEngagement[]
  preachings                 Preaching[]
  preachingBookmarks         PreachingBookmark[]
  preachingComments          PreachingComment[]
  preachingLikes             PreachingLike[]
  preachingNotes             PreachingNote[]
  preachingSeries            PreachingSeries[]
  preachingVerses            PreachingVerse[]
  preachingViews             PreachingView[]
  pushSubscriptions          PushSubscription[]
  radios                     Radio[]
  RadioChatMessage           RadioChatMessage[]
  refreshTokens              RefreshToken[]
  reportsCreated             Report[]                    @relation("ReportReporter")
  reportsResolved            Report[]                    @relation("ReportResolver")
  sessions                   Session[]
  shares                     Share[]
  stories                    Story[]
  storyViews                 StoryView[]
  streams                    Stream[]
  church                     Church?                     @relation("UserChurch", fields: [churchId], references: [id])
  followers                  UserFollow[]                @relation("UserFollowFollower")
  following                  UserFollow[]                @relation("UserFollowFollowing")
  // Profile social relations
  profilePrivacy             ProfilePrivacy?
  albums                     Album[]
  media                      Media[]
  blockedBy                  Block[]                     @relation("Blocked")
  blocking                   Block[]                     @relation("Blocker")
  liveBroadcasts             LiveBroadcast[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  deviceInfo String?
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Post {
  id            String      @id @default(cuid())
  content       String?
  createdAt     DateTime    @default(now())
  authorId      String
  hashtags      String[]    @default([])
  imageUrl      String?
  videoUrl      String?
  isHidden      Boolean     @default(false)
  likes         Int         @default(0)
  churchId      String?
  generatedId   String?
  generatedType String?
  comments      Comment[]
  likeRelations Like[]      @relation("PostLikes")
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  church        Church?     @relation(fields: [churchId], references: [id], onDelete: Cascade)
  shares        Share[]
  postMedias    PostMedia[]

  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([isHidden])
  @@index([likes])
  @@index([churchId])
  @@index([generatedType, generatedId])
}

model PostMedia {
  id        String   @id @default(cuid())
  postId    String
  type      String // "IMAGE" | "VIDEO"
  url       String
  thumbnail String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([order])
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  userId    String
  postId    String
  createdAt DateTime  @default(now())
  parentId  String?
  isHidden  Boolean   @default(false)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId, createdAt])
  @@index([parentId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation("PostLikes", fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Share {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Story {
  id        String      @id @default(cuid())
  imageUrl  String?
  videoUrl  String?
  content   String?
  createdAt DateTime    @default(now())
  expiresAt DateTime
  authorId  String
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views     StoryView[]
}

model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  createdAt DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

model Chat {
  id        String       @id @default(cuid())
  isGroup   Boolean      @default(false)
  name      String?
  createdAt DateTime     @default(now())
  members   ChatMember[]
  messages  Message[]
}

model ChatMember {
  id       String    @id @default(cuid())
  userId   String
  chatId   String
  isTyping Boolean   @default(false)
  lastSeen DateTime?
  chat     Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chatId])
}

model Message {
  id        String        @id @default(cuid())
  content   String
  createdAt DateTime      @default(now())
  chatId    String
  senderId  String
  chat      Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender    User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  seen      MessageSeen[]
}

model MessageSeen {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  seenAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model Notification {
  id         String   @id @default(cuid())
  type       String
  message    String
  userId     String
  createdAt  DateTime @default(now())
  senderId   String?
  entityId   String?
  entityType String?
  read       Boolean  @default(false)
  metadata   Json?
  sender     User?    @relation("NotificationSender", fields: [senderId], references: [id])
  user       User     @relation("NotificationReceiver", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([senderId])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  createdAt DateTime @default(now())
  keys      Json
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Friendship {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  receiver   User     @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("FriendshipSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Report {
  id          String    @id @default(cuid())
  reporterId  String
  targetId    String
  targetType  String
  reason      String
  description String?
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?
  updatedAt   DateTime  @updatedAt
  reporter    User      @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolver    User?     @relation("ReportResolver", fields: [resolvedBy], references: [id])

  @@index([reporterId])
  @@index([targetId])
  @@index([targetType])
  @@index([status])
  @@index([createdAt])
  @@index([targetType, targetId])
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  details   String?
  createdAt DateTime @default(now())
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model PreachingCategory {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  icon        String?
  order       Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  banner      String?
  color       String?
  isActive    Boolean           @default(true)
  preachings  Preaching[]
  series      PreachingSeries[]

  @@index([order])
  @@index([isActive])
  @@index([name])
  @@index([slug])
}

model PreachingSeries {
  id          String             @id @default(cuid())
  title       String
  description String?
  thumbnail   String?
  authorId    String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  banner      String?
  categoryId  String?
  isFeatured  Boolean            @default(false)
  isPublished Boolean            @default(false)
  order       Int                @default(0)
  publishedAt DateTime?
  slug        String             @unique
  preachings  Preaching[]
  author      User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category    PreachingCategory? @relation(fields: [categoryId], references: [id])

  @@index([authorId])
  @@index([categoryId])
  @@index([slug])
  @@index([order])
  @@index([isFeatured])
  @@index([isPublished])
  @@index([publishedAt])
  @@index([categoryId, order])
  @@index([categoryId, isPublished])
}

model Preaching {
  /// /////////////////////////////////////////////////////////
  /// /////////////////////////////////////////////////////////
  id             String              @id @default(cuid())
  title          String
  description    String
  thumbnail      String?
  /// /////////////////////////////////////////////////////////
  /// /////////////////////////////////////////////////////////
  videoUrl       String
  duration       Int?
  /// /////////////////////////////////////////////////////////
  /// /////////////////////////////////////////////////////////
  authorId       String
  categoryId     String?
  seriesId       String?
  publishedAt    DateTime?
  /// /////////////////////////////////////////////////////////
  /// /////////////////////////////////////////////////////////
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  /// /////////////////////////////////////////////////////////
  /// /////////////////////////////////////////////////////////
  allowComments  Boolean             @default(true)
  allowDownload  Boolean             @default(false)
  allowSharing   Boolean             @default(true)
  audioUrl       String?
  banner         String?
  bookmarkCount  Int                 @default(0)
  commentCount   Int                 @default(0)
  isFeatured     Boolean             @default(false)
  isPinned       Boolean             @default(false)
  /// /////////////////////////////////////////////////////////
  /// /////////////////////////////////////////////////////////
  isPublished    Boolean             @default(false)
  language       String              @default("fr")
  likeCount      Int                 @default(0)
  seoDescription String?
  /// /////////////////////////////////////////////////////////
  /// /////////////////////////////////////////////////////////
  seoTitle       String?
  shareCount     Int                 @default(0)
  slug           String              @unique
  /// /////////////////////////////////////////////////////////
  /// /////////////////////////////////////////////////////////
  tags           String[]            @default([])
  /// /////////////////////////////////////////////////////////
  /// /////////////////////////////////////////////////////////
  viewCount      Int                 @default(0)
  /// /////////////////////////////////////////////////////////
  /// /////////////////////////////////////////////////////////
  visibility     String              @default("PUBLIC")
  author         User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category       PreachingCategory?  @relation(fields: [categoryId], references: [id])
  series         PreachingSeries?    @relation(fields: [seriesId], references: [id])
  bookmarks      PreachingBookmark[]
  comments       PreachingComment[]
  likes          PreachingLike[]
  notes          PreachingNote[]
  verses         PreachingVerse[]
  preachingViews PreachingView[]

  @@index([slug])
  @@index([authorId])
  @@index([categoryId])
  @@index([seriesId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([publishedAt])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([visibility])
  @@index([language])
  @@index([viewCount])
  @@index([likeCount])
  @@index([commentCount])
  @@index([bookmarkCount])
  @@index([authorId, createdAt])
  @@index([categoryId, publishedAt])
  @@index([seriesId, publishedAt])
  @@index([isPublished, publishedAt])
  @@index([isFeatured, publishedAt])
}

model PreachingView {
  id            String    @id @default(cuid())
  preachingId   String
  userId        String
  watchedAt     DateTime  @default(now())
  completed     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  device        String?
  ipAddress     String?
  platform      String?
  watchDuration Int?
  watchPercent  Float?
  preaching     Preaching @relation(fields: [preachingId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([preachingId, userId])
  @@index([userId])
  @@index([preachingId])
  @@index([watchedAt])
  @@index([completed])
}

model PreachingLike {
  id          String    @id @default(cuid())
  preachingId String
  userId      String
  createdAt   DateTime  @default(now())
  preaching   Preaching @relation(fields: [preachingId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([preachingId, userId])
  @@index([userId])
  @@index([preachingId])
}

model PreachingComment {
  id          String             @id @default(cuid())
  preachingId String
  userId      String
  content     String
  parentId    String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  isEdited    Boolean            @default(false)
  isHidden    Boolean            @default(false)
  likeCount   Int                @default(0)
  replyCount  Int                @default(0)
  parent      PreachingComment?  @relation("PreachingCommentReplies", fields: [parentId], references: [id])
  replies     PreachingComment[] @relation("PreachingCommentReplies")
  preaching   Preaching          @relation(fields: [preachingId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([preachingId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
}

model PreachingBookmark {
  id          String    @id @default(cuid())
  preachingId String
  userId      String
  createdAt   DateTime  @default(now())
  preaching   Preaching @relation(fields: [preachingId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([preachingId, userId])
  @@index([userId])
  @@index([preachingId])
}

model PreachingNote {
  id          String    @id @default(cuid())
  preachingId String
  userId      String
  content     String
  timestamp   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  color       String?
  title       String?
  preaching   Preaching @relation(fields: [preachingId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([preachingId])
}

model PreachingVerse {
  id          String    @id @default(cuid())
  preachingId String
  book        String
  chapter     Int
  text        String
  createdAt   DateTime  @default(now())
  reference   String
  translation String?
  userId      String
  verseEnd    Int?
  verseStart  Int
  preaching   Preaching @relation(fields: [preachingId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([preachingId])
  @@index([userId])
  @@index([reference])
}

model LiveBroadcast {
  id                 String         @id @default(cuid())
  title              String
  description        String?
  thumbnail          String?
  streamUrl          String?
  authorId           String
  ownerType          String         @default("USER") // "USER" | "CHURCH" | "GLOBAL"
  ownerId            String?
  viewerCount        Int            @default(0)
  status             String         @default("SCHEDULED")
  scheduledAt        DateTime?
  startedAt          DateTime?
  endedAt            DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  rtmpUrl            String?
  streamMode         String         @default("RTMP")
  webrtcUrl          String?
  outputDestinations Json?
  studioConfig       Json?
  churchLives        ChurchLive[]
  author             User           @relation(fields: [authorId], references: [id])
  outputs            StudioOutput[]
  scenes             StudioScene[]

  // Stream identifiers
  streamId     String? @unique
  streamKey    String? @unique
  ingestUrl    String?
  playbackUrl  String?
  rtmpsUrl     String?
  livekitRoom  String?
  livekitToken String?

  // Relay configuration
  relayEnabled Boolean @default(false)
  relayStatus  String  @default("DISABLED")

  // Encoder configuration
  encoder          String?
  ingestProtocol   String? @default("RTMP")
  playbackProtocol String? @default("WEBRTC")

  // Monitoring data
  heartbeatAt     DateTime?
  ingestStatus    String?   @default("OFFLINE")
  duration        Int?      @default(0)
  peakViewerCount Int?      @default(0)
  bitrate         Int?      @default(0)
  bandwidth       Int?      @default(0)
  packetLoss      Float?    @default(0)
  droppedFrames   Int?      @default(0)
  cpuUsage        Float?    @default(0)

  // Recording
  recordingEnabled Boolean         @default(false)
  recordingUrl     String?
  recordingStatus  String?         @default("STOPPED")
  replayUrl        String?
  PrayerRequest    PrayerRequest[]
}

model Church {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  description     String?
  slogan          String?
  logo            String?
  coverImage      String?
  website         String?
  email           String?
  phone           String?
  address         String?
  city            String?
  country         String?
  donationEnabled Boolean          @default(false)
  radioEnabled    Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  schedule        String?
  admins          ChurchAdmin[]
  courses         ChurchCourse[]
  events          ChurchEvent[]
  follows         ChurchFollow[]
  lives           ChurchLive[]
  media           ChurchMedia[]
  members         ChurchMember[]
  posts           ChurchPost[]
  radios          ChurchRadio[]
  playlists       Playlist[]
  globalPosts     Post[]
  users           User[]           @relation("UserChurch")
  prayerRequests  PrayerRequest[]
  // NOUVELLES RELATIONS pour l'évolution du module Prières
  prayerChains    PrayerChain[]
  prayerCampaigns PrayerCampaign[]
}

model ChurchMember {
  id                      String   @id @default(cuid())
  churchId                String
  userId                  String
  role                    String   @default("MEMBER")
  joinedAt                DateTime @default(now())
  isActive                Boolean  @default(true)
  notificationPreferences Json?    @default("{}")
  church                  Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([churchId, userId])
}

model ChurchAdmin {
  id          String   @id @default(cuid())
  churchId    String
  userId      String
  role        String   @default("CHURCH_ADMIN")
  appointedAt DateTime @default(now())
  church      Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([churchId, userId])
}

model ChurchEvent {
  id            String                @id @default(cuid())
  churchId      String
  title         String
  description   String?
  imageUrl      String?
  startDate     DateTime
  endDate       DateTime?
  location      String?
  isPublic      Boolean               @default(true)
  attendeeCount Int                   @default(0)
  createdAt     DateTime              @default(now())
  church        Church                @relation(fields: [churchId], references: [id], onDelete: Cascade)
  attendees     ChurchEventAttendee[]
}

model ChurchEventAttendee {
  id        String      @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime    @default(now())
  status    String      @default("GOING")
  event     ChurchEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model ChurchMedia {
  id        String   @id @default(cuid())
  churchId  String
  type      String   @default("IMAGE")
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  caption   String?
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
}

model ChurchRadio {
  id          String    @id @default(cuid())
  churchId    String
  radioId     String?
  name        String?
  streamUrl   String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  playlistId  String?
  description String?
  schedule    String?
  title       String?
  church      Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  playlist    Playlist? @relation("PlaylistChurchRadios", fields: [playlistId], references: [id])
  radio       Radio?    @relation(fields: [radioId], references: [id])
}

model ChurchLive {
  id                 String    @id @default(cuid())
  churchId           String
  liveBroadcastId    String?
  title              String?
  description        String?
  thumbnail          String?
  streamUrl          String?
  viewerCount        Int       @default(0)
  status             String    @default("SCHEDULED")
  scheduledAt        DateTime?
  scheduledStart     DateTime?
  scheduledEnd       DateTime?
  startedAt          DateTime?
  endedAt            DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  rtmpUrl            String?
  streamMode         String?
  webrtcUrl          String?
  outputDestinations Json?
  studioConfig       Json?
  playUrl            String?

  // Stream identifiers
  streamId     String? @unique
  streamKey    String? @unique
  ingestUrl    String?
  playbackUrl  String?
  rtmpsUrl     String?
  livekitRoom  String?
  livekitToken String?

  // Relay configuration
  relayEnabled Boolean @default(false)
  relayStatus  String  @default("DISABLED")

  // Encoder configuration
  encoder          String?
  ingestProtocol   String? @default("RTMP")
  playbackProtocol String? @default("WEBRTC")

  // Monitoring data
  heartbeatAt     DateTime?
  ingestStatus    String?   @default("OFFLINE")
  duration        Int?      @default(0)
  peakViewerCount Int?      @default(0)
  bitrate         Int?      @default(0)
  bandwidth       Int?      @default(0)
  packetLoss      Float?    @default(0)
  droppedFrames   Int?      @default(0)
  cpuUsage        Float?    @default(0)

  // Recording
  recordingEnabled Boolean @default(false)
  recordingUrl     String?
  recordingStatus  String? @default("STOPPED")

  church    Church         @relation(fields: [churchId], references: [id], onDelete: Cascade)
  broadcast LiveBroadcast? @relation(fields: [liveBroadcastId], references: [id])
  scenes    StudioScene[]
}

model ChurchCourse {
