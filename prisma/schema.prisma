model RadioSchedule {
  id          String    @id @default(cuid())
  radioId     String
  playlistId  String?
  title       String
  description String?
  hostName    String?
  startTime   DateTime
  endTime     DateTime?
  duration    Int       @default(60)
  isRecurring Boolean   @default(false)
  recurrence  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  playlist    Playlist? @relation(fields: [playlistId], references: [id])
  radio       Radio     @relation(fields: [radioId], references: [id], onDelete: Cascade)

  @@index([radioId])
  @@index([startTime])
}

model RadioChatMessage {
  id        String    @id @default(cuid())
  radioId   String
  userId    String?
  content   String
  isPinned  Boolean   @default(false)
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  pinnedAt  DateTime?
  updatedAt DateTime  @updatedAt
  radio     Radio     @relation(fields: [radioId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  @@index([radioId])
  @@index([userId])
  @@index([createdAt])
}

model StudioScene {
  id           String         @id @default(cuid())
  name         String
  description  String?
  order        Int            @default(0)
  isActive     Boolean        @default(false)
  broadcastId  String?
  churchLiveId String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  broadcast    LiveBroadcast? @relation(fields: [broadcastId], references: [id])
  churchLive   ChurchLive?    @relation(fields: [churchLiveId], references: [id])
  sources      StudioSource[]

  @@index([broadcastId])
  @@index([churchLiveId])
  @@index([order])
}

model StudioSource {
  id        String      @id @default(cuid())
  type      String
  name      String
  url       String?
  settings  Json?
  order     Int         @default(0)
  isVisible Boolean     @default(true)
  volume    Int         @default(100)
  muted     Boolean     @default(false)
  sceneId   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  scene     StudioScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId])
  @@index([type])
}

model StudioOutput {
  id          String         @id @default(cuid())
  name        String
  type        String // "CHURCHFACE" | "RTMP" | "WEBRTC" | "HLS" | "DASH"
  platform    String? // "CHURCHFACE" | "YOUTUBE" | "FACEBOOK" | "TWITCH" | "CUSTOM_RTMP"
  enabled     Boolean        @default(true)
  isPrimary   Boolean        @default(false) // ChurchFace is always primary
  config      Json?
  streamKey   String?
  streamUrl   String?
  status      String         @default("OFFLINE")
  broadcastId String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  broadcast   LiveBroadcast? @relation(fields: [broadcastId], references: [id])

  @@index([broadcastId])
  @@index([type])
  @@index([enabled])
  @@index([isPrimary])
  @@index([platform])
}

// Broadcast Hub System
model BroadcastAccount {
  id                    String                 @id @default(cuid())
  ownerType             String // "USER" | "CHURCH"
  userId                String?
  churchId              String?
  platform              String // "YOUTUBE" | "FACEBOOK" | "TWITCH" | "RTMP"
  accountName           String
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  status                String                 @default("ACTIVE") // "ACTIVE" | "REVOKED" | "EXPIRED"
  metadata              Json? // Platform-specific data
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  lastUsedAt            DateTime?
  destinations          BroadcastDestination[]

  @@index([ownerType, userId])
  @@index([ownerType, churchId])
  @@index([platform])
  @@index([status])
}

model BroadcastDestination {
  id                 String           @id @default(cuid())
  broadcastAccountId String
  name               String
  platform           String
  enabled            Boolean          @default(true)
  isDefault          Boolean          @default(false)
  configuration      Json? // Stream key, RTMP URL, etc.
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  account            BroadcastAccount @relation(fields: [broadcastAccountId], references: [id], onDelete: Cascade)

  @@index([broadcastAccountId])
  @@index([platform])
  @@index([enabled])
}

model BroadcastPermission {
  id          String   @id @default(cuid())
  churchId    String
  userId      String?
  role        String // "BROADCAST_MANAGER" | "STUDIO_OPERATOR"
  permissions Json?    @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([churchId, userId])
  @@index([churchId])
  @@index([userId])
  @@index([role])
}

// Profile Privacy Settings
model ProfilePrivacy {
  id               String   @id @default(cuid())
  userId           String   @unique
  profileLocked    Boolean  @default(false)
  postVisibility   String   @default("PUBLIC") // PUBLIC, FRIENDS, PRIVATE
  friendVisibility String   @default("PUBLIC") // PUBLIC, FRIENDS, PRIVATE
  followPermission String   @default("EVERYONE") // EVERYONE, FRIENDS
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

// Media Albums
model Album {
  id         String   @id @default(cuid())
  userId     String
  name       String
  type       String   @default("CUSTOM") // PROFILE, COVER, CUSTOM
  visibility String   @default("PUBLIC") // PUBLIC, FRIENDS, PRIVATE
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  media      Media[]

  @@index([userId])
  @@index([type])
  @@index([visibility])
}

// Media Items (Photos/Videos)
model Media {
  id         String   @id @default(cuid())
  userId     String
  albumId    String?
  type       String // PHOTO, VIDEO
  url        String
  thumbnail  String?
  caption    String?
  visibility String   @default("PUBLIC")
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  album      Album?   @relation(fields: [albumId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([albumId])
  @@index([type])
  @@index([visibility])
  @@index([createdAt])
}

// User Blocking
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}
