}

model ChurchPostComment {
  id           String     @id @default(cuid())
  churchPostId String
  userId       String
  content      String
  createdAt    DateTime   @default(now())
  post         ChurchPost @relation(fields: [churchPostId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChurchFollow {
  id        String   @id @default(cuid())
  churchId  String
  userId    String
  createdAt DateTime @default(now())
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([churchId, userId])
}

model Stream {
  id          String    @id @default(cuid())
  title       String
  description String?
  isLive      Boolean   @default(false)
  startedAt   DateTime?
  viewerCount Int       @default(0)
  userId      String?
  createdAt   DateTime  @default(now())
  status      String    @default("OFFLINE")
  streamUrl   String?
  user        User?     @relation(fields: [userId], references: [id])
}

model Radio {
  id             String             @id @default(cuid())
  title          String
  description    String?
  isLive         Boolean            @default(false)
  isAutoDJ       Boolean            @default(false)
  startedAt      DateTime?
  endedAt        DateTime?
  listenerCount  Int                @default(0)
