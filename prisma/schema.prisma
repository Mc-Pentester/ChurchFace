  @@index([churchId])
}

model PlaylistItem {
  id         String    @id @default(cuid())
  title      String
  url        String
  type       String    @default("AUDIO")
  duration   Int?
  order      Int       @default(0)
  playlistId String?
  createdAt  DateTime  @default(now())
  playlist   Playlist? @relation(fields: [playlistId], references: [id])
}

model PrayerRequest {
  id               String    @id @default(cuid())
  userId           String
  title            String
  content          String
  category         String?
  isUrgent         Boolean   @default(false)
  isAnswered       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  prayerChainId    String?
  churchId         String?
  // NOUVEAUX CHAMPS OPTIONNELS pour intégrations futures
  // Note: Group, Ministry, Event modèles à créer ultérieurement
  groupId          String?
  ministryId       String?
  eventId          String?
  liveBroadcastId  String?
  prayerCampaignId String?
  prayerRoomId     String?
  scheduledAt      DateTime?
  status           String?   @default("ACTIVE") // ACTIVE, ANSWERED, ARCHIVED

  reactions      PrayerReaction[]
  prayerChain    PrayerChain?       @relation(fields: [prayerChainId], references: [id])
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses      PrayerResponse[]
  testimony      PrayerTestimony?
  verses         PrayerVerse[]
  engagements    PrayerEngagement[]
  church         Church?            @relation(fields: [churchId], references: [id], onDelete: Cascade)
  // Relations futures (à activer quand les modèles seront créés)
  // group             Group?              @relation(fields: [groupId], references: [id])
  // ministry          Ministry?           @relation(fields: [ministryId], references: [id])
  // event             Event?              @relation(fields: [eventId], references: [id])
  liveBroadcast  LiveBroadcast?     @relation(fields: [liveBroadcastId], references: [id])
  prayerCampaign PrayerCampaign?    @relation(fields: [prayerCampaignId], references: [id])
  prayerRoom     PrayerRoom?        @relation(fields: [prayerRoomId], references: [id])

  @@index([churchId])
  @@index([groupId])
  @@index([ministryId])
  @@index([eventId])
  @@index([liveBroadcastId])
  @@index([prayerCampaignId])
  @@index([prayerRoomId])
  @@index([scheduledAt])
  @@index([status])
}

model PrayerLiveRoom {
  id                        String                      @id @default(cuid())
  title                     String
  description               String?
  isPublic                  Boolean                     @default(true)
  isActive                  Boolean                     @default(true)
  moderatorId               String
  createdAt                 DateTime                    @default(now())
  participants              PrayerLiveParticipant[]
  moderator                 User                        @relation(fields: [moderatorId], references: [id], onDelete: Cascade)
  PrayerLiveRoomMember      PrayerLiveRoomMember[]
  PrayerLiveRoomParticipant PrayerLiveRoomParticipant[]
}

model PrayerLiveParticipant {
  id       String         @id @default(cuid())
  roomId   String
  userId   String
  joinedAt DateTime       @default(now())
  room     PrayerLiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model PrayerLiveRoomMember {
  id       String         @id @default(cuid())
  roomId   String
  userId   String
  joinedAt DateTime       @default(now())
  room     PrayerLiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model PrayerLiveRoomParticipant {
  id       String         @id @default(cuid())
  roomId   String
  userId   String
  joinedAt DateTime       @default(now())
  room     PrayerLiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model PrayerChain {
  id               String    @id @default(cuid())
  prayerRequestId  String?
  title            String
  description      String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  // NOUVEAUX CHAMPS OPTIONNELS
  ownerId          String?
  ownerType        String? // "USER" | "CHURCH" | "GROUP" | "MINISTRY" | "EVENT"
  churchId         String?
  // Note: Group, Ministry, Event modèles à créer ultérieurement
  groupId          String?
  ministryId       String?
  eventId          String?
  imageUrl         String?
  visibility       String?   @default("PUBLIC") // PUBLIC, PRIVATE, CHURCH_ONLY
  prayerCampaignId String?
  scheduledStart   DateTime?
  scheduledEnd     DateTime?

  links          PrayerChainLink[]
  prayerRequests PrayerRequest[]
  participants   PrayerParticipant[]
  // Relations nouvelles (optionnelles)
  owner          User?               @relation("PrayerChainOwner", fields: [ownerId], references: [id])
  church         Church?             @relation(fields: [churchId], references: [id])
  // Relations futures (à activer quand les modèles seront créés)
  // group           Group?              @relation(fields: [groupId], references: [id])
  // ministry        Ministry?           @relation(fields: [ministryId], references: [id])
  // event           Event?              @relation(fields: [eventId], references: [id])
  prayerCampaign PrayerCampaign?     @relation(fields: [prayerCampaignId], references: [id])
  PrayerSchedule PrayerSchedule[]
  PrayerRoom     PrayerRoom[]

  @@index([ownerId])
  @@index([churchId])
  @@index([groupId])
  @@index([ministryId])
  @@index([eventId])
  @@index([prayerCampaignId])
  @@index([visibility])
  @@index([scheduledStart])
}

model PrayerChainLink {
  id                  String    @id @default(cuid())
  chainId             String
  userId              String
  message             String?
  createdAt           DateTime  @default(now())
  // NOUVEAUX CHAMPS OPTIONNELS
  role                String?   @default("PARTICIPANT") // PARTICIPANT, INTERCESSOR, MODERATOR, ADMIN
  joinedAt            DateTime  @default(now())
  lastPrayedAt        DateTime?
  prayerCount         Int       @default(0)
  notificationEnabled Boolean   @default(true)

  chain PrayerChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chainId, userId])
}

model PrayerReaction {
  id              String        @id @default(cuid())
  prayerRequestId String
  userId          String
  type            String        @default("PRAY")
  createdAt       DateTime      @default(now())
  prayerRequest   PrayerRequest @relation(fields: [prayerRequestId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, prayerRequestId, type])
}

model PrayerResponse {
  id              String        @id @default(cuid())
  prayerRequestId String
  userId          String
  content         String
  type            String        @default("PRAYER")
  createdAt       DateTime      @default(now())
  prayerRequest   PrayerRequest @relation(fields: [prayerRequestId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PrayerVerse {
  id              String        @id @default(cuid())
  prayerRequestId String
  userId          String
  reference       String
  text            String?
  createdAt       DateTime      @default(now())
  prayerRequest   PrayerRequest @relation(fields: [prayerRequestId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([prayerRequestId])
  @@index([userId])
}

model PrayerTestimony {
  id              String        @id @default(cuid())
  prayerRequestId String        @unique
  userId          String
  content         String
  imageUrl        String?
  videoUrl        String?
  createdAt       DateTime      @default(now())
  prayerRequest   PrayerRequest @relation(fields: [prayerRequestId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ===== NOUVEAUX MODÈLES POUR L'ÉVOLUTION DU MODULE PRIÈRES =====

// PrayerParticipant - Système de participation avancé aux chaînes de prière
model PrayerParticipant {
  id                  String    @id @default(cuid())
  prayerChainId       String
  userId              String
  role                String    @default("PARTICIPANT") // PARTICIPANT, INTERCESSOR, MODERATOR, ADMIN
  joinedAt            DateTime  @default(now())
  lastPrayedAt        DateTime?
  prayerCount         Int       @default(0)
  notificationEnabled Boolean   @default(true)

  prayerChain PrayerChain @relation(fields: [prayerChainId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([prayerChainId, userId])
  @@index([prayerChainId])
  @@index([userId])
  @@index([role])
}

// PrayerSchedule - Calendrier d'intercession
model PrayerSchedule {
  id            String   @id @default(cuid())
  prayerChainId String
  userId        String
  hour          Int // 0-23
  dayOfWeek     Int? // 0-6 (null = tous les jours)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  prayerChain PrayerChain @relation(fields: [prayerChainId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([prayerChainId, userId, hour, dayOfWeek])
  @@index([prayerChainId])
  @@index([userId])
  @@index([hour])
}

// PrayerRoom - Salles de prière étendues (text/audio/video)
model PrayerRoom {
  id              String    @id @default(cuid())
  prayerChainId   String?
  title           String
  description     String?
  roomType        String    @default("TEXT") // TEXT, AUDIO, VIDEO
  isPublic        Boolean   @default(true)
  isActive        Boolean   @default(true)
  moderatorId     String
  maxParticipants Int?
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  createdAt       DateTime  @default(now())
  endedAt         DateTime?

  prayerChain   PrayerChain?            @relation(fields: [prayerChainId], references: [id])
  moderator     User                    @relation("PrayerRoomModerator", fields: [moderatorId], references: [id], onDelete: Cascade)
  participants  PrayerRoomParticipant[]
  PrayerRequest PrayerRequest[]

  @@index([prayerChainId])
  @@index([moderatorId])
  @@index([isActive])
  @@index([scheduledStart])
}

// PrayerRoomParticipant - Participants aux salles de prière
model PrayerRoomParticipant {
  id            String   @id @default(cuid())
  roomId        String
  userId        String
  joinedAt      DateTime @default(now())
  isMuted       Boolean  @default(false)
  hasHandRaised Boolean  @default(false)

  room PrayerRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}

// PrayerCampaign - Campagnes de prière (jeûne, veillée, etc.)
model PrayerCampaign {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  type        String // "FAST", "PRAYER", "VIGIL", "NATIONAL", "GLOBAL"
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  churchId    String?
  createdBy   String
  createdAt   DateTime @default(now())

  chains        PrayerChain[]
  church        Church?         @relation(fields: [churchId], references: [id])
  creator       User            @relation("PrayerCampaignCreator", fields: [createdBy], references: [id])
  PrayerRequest PrayerRequest[]

  @@index([churchId])
  @@index([createdBy])
  @@index([startDate, endDate])
  @@index([type])
  @@index([isActive])
}

// PrayerEngagement - Nouveaux types d'engagement
model PrayerEngagement {
  id              String   @id @default(cuid())
  prayerRequestId String
  userId          String
  type            String // "PRAYED", "CONTINUING", "SHARED_VERSE", "ENCOURAGED"
  createdAt       DateTime @default(now())

  prayerRequest PrayerRequest @relation(fields: [prayerRequestId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([prayerRequestId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model AudioTrack {
  id         String   @id @default(cuid())
  title      String
  artist     String?
  album      String?
  url        String
  coverUrl   String?
  duration   Int?
  type       String   @default("MUSIC")
  category   String?
  isActive   Boolean  @default(true)
  uploadedBy String?
  createdAt  DateTime @default(now())
  uploader   User?    @relation(fields: [uploadedBy], references: [id])
