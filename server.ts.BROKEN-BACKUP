    // SEEN MESSAGES
    // ==================================================

    socket.on(
      "message:seen",
      async ({
        chatId,
        userId,
      }) => {
        try {
          if (
            !chatId ||
            !userId
          ) {
            return;
          }

          const unseen =
            await prisma.message.findMany(
              {
                where: {
                  chatId,

                  senderId: {
                    not: userId,
                  },
                },

                select: {
                  id: true,
                },
              }
            );

          for (
            const msg of unseen
          ) {
            await prisma.messageSeen.upsert(
              {
                where: {
                  messageId_userId:
                    {
                      messageId:
                        msg.id,

                      userId,
                    },
                },

                create: {
                  messageId:
                    msg.id,

                  userId,
                },

                update: {},
              }
            );
          }

          io.to(chatId).emit(
            "message:seen",
            {
              userId,
              chatId,
            }
          );
        } catch (err) {
          console.error(
            "message:seen handler failed:",
            err
          );
        }
      }
    );

