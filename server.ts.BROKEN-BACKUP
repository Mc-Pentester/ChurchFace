            targetRole:
              "listener",

            event:
              "radio:offer",

            payload: {
              offer,

              senderId:
                socket.id,
            },
          });

        if (!delivered) {
          console.warn(
            "Rejected stale radio offer",
            {
              radioId,
              source:
                socket.id,
              target,
            }
          );
        }
      }
    );

