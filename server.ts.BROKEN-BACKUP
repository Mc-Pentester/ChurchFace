        try {
          if (
            !fromUserId ||
            !toUserId ||
            fromUserId ===
              toUserId
          ) {
            return;
          }

          await createNotification({
            userId: toUserId,
            senderId: fromUserId,
            type: "FOLLOW",
            message: "a commencé à vous suivre 👤",
