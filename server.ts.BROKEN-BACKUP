            sourceSocketId:
              socket.id,

            targetSocketId:
              broadcaster.socketId,

            sourceRole:
              "listener",

            targetRole:
              "broadcaster",

            event:
              "radio:listener-joined",

            payload:
              socket.id,
          });
        }

        emitRadioStats(
          radioId
        );
